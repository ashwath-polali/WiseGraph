generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Teacher {
  id                 String           @id @default(uuid())
  email              String         
  name               String?
  accountType        String           @default("teacher")
  createdAt          DateTime         @default(now())
  defaultClassId     String?
  defaultStudentView String?
  school             String?
  classes            Class[]
  PsychStudent       PsychStudent[]
  ScoreSnapshots     ScoreSnapshot[]  // NEW
}

model Class {
  id             String          @id @default(uuid())
  teacherId      String
  name           String
  gradeLevel     String
  subject        String
  term           String?
  createdAt      DateTime        @default(now())
  categories     Category[]
  teacher        Teacher         @relation(fields: [teacherId], references: [id])
  students       Student[]
  scoreSnapshots ScoreSnapshot[] // NEW
}

model Student {
  id           String   @id @default(uuid())
  classId      String
  name         String
  studentCode  String?
  gradeLevel   String
  overallScore Int
  createdAt    DateTime @default(now())
  scores       Score[]
  class        Class    @relation(fields: [classId], references: [id])
}

model Category {
  id            String        @id @default(uuid())
  classId       String
  name          String
  order         Int           @default(0)
  class         Class         @relation(fields: [classId], references: [id])
  scores        Score[]
  subcategories Subcategory[]
}

model Subcategory {
  id         String   @id @default(uuid())
  categoryId String
  name       String
  order      Int      @default(0)
  scores     Score[]
  category   Category @relation(fields: [categoryId], references: [id])
}

model Score {
  id            String       @id @default(uuid())
  studentId     String
  categoryId    String?
  subcategoryId String?
  standardScore Int
  createdAt     DateTime     @default(now())
  category      Category?    @relation(fields: [categoryId], references: [id])
  student       Student      @relation(fields: [studentId], references: [id])
  subcategory   Subcategory? @relation(fields: [subcategoryId], references: [id])

  @@unique([studentId, categoryId, subcategoryId], name: "student_category_sub_unique")
}

model PsychStudent {
  id             String          @id @default(uuid())
  teacherId      String
  name           String
  gradeLevel     String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  teacher        Teacher         @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subtests       PsychSubtest[]
  scoreSnapshots ScoreSnapshot[] // NEW

  @@unique([teacherId, name])
}

model PsychSubtest {
  id            String       @id @default(uuid())
  studentId     String
  name          String
  standardScore Int
  createdAt     DateTime     @default(now())
  student       PsychStudent @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, name])
}

// NEW: Represents a finalized term/quarter snapshot
model ScoreSnapshot {
  id             String          @id @default(uuid())
  name           String          // "Term 1", "Q2", "Fall 2024", etc.
  classId        String?         // For teacher accounts (entire class snapshot)
  teacherId      String          // Owner of this snapshot
  psychStudentId String?         // For psychologist accounts (single student)
  snapshotDate   DateTime        @default(now())
  createdAt      DateTime        @default(now())

  scores       SnapshotScore[]
  
  class        Class?        @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacher      Teacher       @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  psychStudent PsychStudent? @relation(fields: [psychStudentId], references: [id], onDelete: Cascade)

  @@index([classId])
  @@index([psychStudentId])
  @@index([teacherId])
}

// NEW: Frozen scores from a specific term
model SnapshotScore {
  id              String   @id @default(uuid())
  snapshotId      String
  studentId       String?  // Original student ID (may be null if student deleted)
  studentName     String   // Store name in case student is deleted later
  categoryId      String?
  categoryName    String
  subcategoryId   String?
  subcategoryName String?
  standardScore   Int
  overallScore    Int      // Student's overall score at time of snapshot
  createdAt       DateTime @default(now())

  snapshot ScoreSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@index([snapshotId])
  @@index([studentId])
}
