// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ------------------ MODELS ------------------

model Teacher {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  classes   Class[]
  createdAt DateTime @default(now())

  // Settings fields
  school             String?
  defaultClassId     String?
  defaultClass       Class?   @relation("DefaultClass", fields: [defaultClassId], references: [id])
  defaultStudentView String?  // "polar" | "bell" | "concentric"
}

model Class {
  id         String    @id @default(uuid())
  teacherId  String
  teacher    Teacher   @relation(fields: [teacherId], references: [id])
  name       String
  gradeLevel String
  subject    String
  term       String?
  students   Student[]
  categories Category[]
  createdAt  DateTime  @default(now())

  defaultForTeachers Teacher[] @relation("DefaultClass")
}

model Student {
  id           String   @id @default(uuid())
  classId      String
  class        Class    @relation(fields: [classId], references: [id])
  name         String
  studentCode  String?
  gradeLevel   String
  overallScore Int
  scores       Score[]
  createdAt    DateTime @default(now())
}

model Category {
  id           String        @id @default(uuid())
  classId      String
  class        Class         @relation(fields: [classId], references: [id])
  name         String
  order        Int           @default(0)
  subcategories Subcategory[]
  scores       Score[]       // <-- add this line
}

model Subcategory {
  id         String      @id @default(uuid())
  categoryId String
  category   Category    @relation(fields: [categoryId], references: [id])
  name       String
  order      Int         @default(0)
  scores     Score[]
}

model Score {
  id            String       @id @default(uuid())
  studentId     String
  student       Student      @relation(fields: [studentId], references: [id])
  categoryId    String?
  category      Category?    @relation(fields: [categoryId], references: [id])
  subcategoryId String?
  subcategory   Subcategory? @relation(fields: [subcategoryId], references: [id])
  standardScore Int
  createdAt     DateTime     @default(now())

  @@unique([studentId, categoryId, subcategoryId], name: "student_category_sub_unique")
}