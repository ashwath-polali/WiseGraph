generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Teacher {
  id                 String             @id @default(uuid())
  email              String         
  name               String?
  accountType        String             @default("teacher")
  createdAt          DateTime           @default(now())
  defaultClassId     String?
  defaultStudentView String?
  school             String?
  onboardedAt        DateTime?
  classes            Class[]
  PsychStudent       PsychStudent[]
  ScoreSnapshots     ScoreSnapshot[]
  UniversalTemplate  UniversalTemplate? // NEW
}

model Class {
  id             String          @id @default(uuid())
  teacherId      String
  name           String
  gradeLevel     String
  subject        String
  term           String?
  createdAt      DateTime        @default(now())
  categories     Category[]
  teacher        Teacher         @relation(fields: [teacherId], references: [id])
  students       Student[]
  scoreSnapshots ScoreSnapshot[]
}

model Student {
  id           String   @id @default(uuid())
  classId      String
  name         String
  studentCode  String?
  gradeLevel   String
  overallScore Int
  createdAt    DateTime @default(now())
  scores       Score[]
  class        Class    @relation(fields: [classId], references: [id])
}

model Category {
  id            String        @id @default(uuid())
  classId       String
  name          String
  order         Int           @default(0)
  class         Class         @relation(fields: [classId], references: [id])
  scores        Score[]
  subcategories Subcategory[]
}

model Subcategory {
  id         String   @id @default(uuid())
  categoryId String
  name       String
  order      Int      @default(0)
  scores     Score[]
  category   Category @relation(fields: [categoryId], references: [id])
}

model Score {
  id            String       @id @default(uuid())
  studentId     String
  categoryId    String?
  subcategoryId String?
  standardScore Int
  createdAt     DateTime     @default(now())
  category      Category?    @relation(fields: [categoryId], references: [id])
  student       Student      @relation(fields: [studentId], references: [id])
  subcategory   Subcategory? @relation(fields: [subcategoryId], references: [id])

  @@unique([studentId, categoryId, subcategoryId], name: "student_category_sub_unique")
}

model PsychStudent {
  id             String          @id @default(uuid())
  teacherId      String
  name           String
  gradeLevel     String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  teacher        Teacher         @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subtests       PsychSubtest[]
  scoreSnapshots ScoreSnapshot[]

  @@unique([teacherId, name])
}

model PsychSubtest {
  id            String       @id @default(uuid())
  studentId     String
  name          String
  standardScore Int
  createdAt     DateTime     @default(now())
  student       PsychStudent @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, name])
}

model ScoreSnapshot {
  id             String          @id @default(uuid())
  name           String
  classId        String?
  teacherId      String
  psychStudentId String?
  snapshotDate   DateTime        @default(now())
  createdAt      DateTime        @default(now())

  scores       SnapshotScore[]
  
  class        Class?        @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacher      Teacher       @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  psychStudent PsychStudent? @relation(fields: [psychStudentId], references: [id], onDelete: Cascade)

  @@index([classId])
  @@index([psychStudentId])
  @@index([teacherId])
}

model SnapshotScore {
  id              String   @id @default(uuid())
  snapshotId      String
  studentId       String?
  studentName     String
  categoryId      String?
  categoryName    String
  subcategoryId   String?
  subcategoryName String?
  standardScore   Int
  overallScore    Int
  createdAt       DateTime @default(now())

  snapshot ScoreSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@index([snapshotId])
  @@index([studentId])
}

// NEW: Store universal category templates as JSON
model UniversalTemplate {
  id         String   @id @default(uuid())
  teacherId  String   @unique
  categories Json     // Stores the entire category structure
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
}
